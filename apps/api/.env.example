# Antenne API configuration.
#
# Development values come from Casier — `mise run dev` wraps the API in
# `casier run`, so nothing has to exist on disk. This file documents what the
# API reads and gives a working local fallback.

# Required. The API exits 1 without it.
DATABASE_URL=postgres://antenne:antenne@localhost:5432/antenne?sslmode=disable

# development | staging | production. Never gates security behaviour, but
# production refuses to boot without an admin password and a session secret.
APP_ENV=development

# Uncommented on purpose. Antenne does NOT take tronc's 8080 default: the webhook
# URLs registered in Dokploy, DocuSeal and the git forges all point at 9090, and
# the client's dev proxy targets it too.
PORT=9090

LOG_LEVEL=debug

# Comma-separated CORS origins. Unset denies every cross-origin caller, which is
# correct for the single-container deployment — the dashboard is same-origin.
# ALLOWED_ORIGINS and DOMAINS remain accepted fallbacks, read through tronc/env.
CORS_ALLOWED_ORIGINS=

# The bootstrap login. Antenne refuses to boot with neither this nor OIDC_ISSUER
# below: there is no open mode. Changing this and restarting re-seeds the
# credential and revokes that account's sessions, which is the recovery path.
ANTENNE_ADMIN_USERNAME=admin
ANTENNE_ADMIN_PASSWORD=

# The https origin Antenne is reached on. porte derives the session cookie's
# Secure attribute and its __Host- prefix from this rather than from a proxy
# header, so a proxy that stops sending X-Forwarded-Proto downgrades nothing.
PUBLIC_URL=

# Single sign-on against the suite's Authentik. Leave OIDC_ISSUER empty to run
# on the password login alone; set SSO_ONLY=true to drop the password entirely.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SUCCESS_URL=
SSO_ONLY=false

# Shared secret pool clients present when registering. The dashboard value wins
# over this one, so it can be rotated without a redeploy.
ANTENNE_SECRET=

# Website check timeout, in seconds.
TIMEOUT=10

# Journal log shipping, server side. Both must be set for anything to ship. This
# URL is Journal's docker-internal address, which no browser can resolve.
JOURNAL_URL=
JOURNAL_TOKEN=

# Journal error reporting, browser side — the dashboard's own errors. Both must
# be set, and the key is a `public` key from Journal's Settings -> API listing
# this deployment's origin. It ends up in the browser, which is expected: the
# origin allowlist, the rate limit and the quota are what protect the instance.
#
# JOURNAL_BROWSER_URL must end in /api. Antenne refuses to boot otherwise:
# Journal's dashboard answers an unmatched path with 200 and HTML, so a base URL
# without the suffix discards every report in silence.
JOURNAL_BROWSER_URL=
JOURNAL_BROWSER_KEY=

# Dead man's switch. Antenne pings this URL on a schedule and something else
# alarms when the pings stop — which is the only way a failure of Antenne itself
# gets reported, since it cannot announce its own silence. Works with
# healthchecks.io, Dead Man's Snitch or Grafana OnCall. Empty disables it.
#
# The ping is withheld unless the process is genuinely working (database
# reachable, the monitor loop has completed a cycle), so a wedged Antenne goes
# quiet rather than reporting itself healthy. Set the receiver's period a little
# above HEARTBEAT_INTERVAL and give it real grace time.
HEARTBEAT_URL=
# Default 5m; the loader rejects anything under 1m.
HEARTBEAT_INTERVAL=5m
