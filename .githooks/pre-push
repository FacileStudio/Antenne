#!/usr/bin/env sh
#
# Quality gate, run before every push: gofmt -l, go vet and go test over every
# Go module, the client type-check, then `filet gate` (the filet rules and a
# douane scan). Reports only; never rewrites a file.
# Run `sh scripts/check.sh --format` to fix formatting.
#
# Bypass once with:      git push --no-verify
# Enable in a clone with: git config core.hooksPath .githooks   (or mise run hooks)

set -eu
root="$(git rev-parse --show-toplevel)"
sh "$root/scripts/check.sh"
exec filet gate "$root"
